{
  "name": "backend-resultados-montalvo",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=22.12" },
  "scripts": {
    "generate": "prisma generate",
    "build": "npm run generate && tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/src/main.js",
    "worker": "node --env-file-if-exists=.env dist/src/worker.js",
    "migrate": "node --env-file-if-exists=.env node_modules/prisma/build/index.js migrate deploy",
    "usuario": "node --env-file-if-exists=.env dist/src/provisionar.js",
    "test": "npm run build && node --test dist/test/unit.test.js",
    "test:integration": "npm run build && node --test dist/test/integration.test.js"
  },
  "dependencies": {
    "@nestjs/common": "12.0.4",
    "@nestjs/core": "12.0.4",
    "@nestjs/platform-express": "12.0.4",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "aws4fetch": "1.0.20",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "helmet": "8.1.0",
    "pdf-lib": "1.17.1",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "overrides": {
    "@prisma/config": { "deepmerge-ts": "8.0.2" },
    "mysql2": "3.24.4"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/multer": "2.0.0",
    "@types/node": "22.20.1",
    "prisma": "7.10.0",
    "typescript": "5.9.3"
  }
}

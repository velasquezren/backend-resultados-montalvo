NODE_ENV=development
PORT=3010
# Base y usuario exclusivos. No usar DATABASE_URL ni credenciales del CRM.
RESULTADOS_DATABASE_URL=postgresql://resultados_app:cambiar@127.0.0.1:5432/resultados
# Generar con: openssl rand -hex 32. No copiar la clave de otro sistema.
SESSION_HMAC_KEY=
CORS_ORIGINS=http://localhost:3011
PATIENT_PORTAL_URL=http://localhost:3011/resultados
STORAGE_DRIVER=local
PRIVATE_STORAGE_DIR=./var/private
# Obligatorios en producción: almacenamiento privado y ClamAV.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
CLAMAV_HOST=
CLAMAV_PORT=3310
NOTIFICATIONS_ENABLED=false
NOTIFICATION_DAILY_LIMIT=100
META_GRAPH_VERSION=v25.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=es
META_APP_SECRET=
META_VERIFY_TOKEN=
# Credencial exclusiva para lectura de eventos administrativos desde el CRM.
CRM_INTEGRATION_TOKEN=

# Alternativa privada en servidor: STORAGE_DRIVER=local-encrypted
# Generar una clave exclusiva y conservar copia segura fuera del servidor.
STORAGE_ENCRYPTION_KEY=
HOST=127.0.0.1

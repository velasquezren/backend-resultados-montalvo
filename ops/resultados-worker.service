# Mantenimiento de Resultados Montalvo.
#
# Una vez por hora purga sesiones vencidas y contadores de intentos
# (`Mantenimiento.limpiar`). Sin él, `Sesion` y `LimiteIntentos` crecen
# indefinidamente.
#
# Hasta el 2026-09-22 este proceso también despachaba avisos de WhatsApp. Ese
# camino se retiró sin haberse encendido: el emisor es el CRM.
#
# Instalar:
#   cp ops/resultados-worker.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now resultados-worker
[Unit]
Description=Mantenimiento de Resultados Montalvo
After=network.target postgresql.service
[Service]
User=resultados
Group=resultados
WorkingDirectory=/opt/montalvo-resultados/current
EnvironmentFile=/etc/montalvo-resultados/api.env
ExecStart=/usr/bin/node dist/src/worker.js
Restart=on-failure
RestartSec=5
# Duerme casi siempre: dos DELETE por hora, sin PDF ni red externa.
MemoryMax=160M
CPUQuota=20%
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077
[Install]
WantedBy=multi-user.target
